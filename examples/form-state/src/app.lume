component App {
  state email: String = ""
  state note: String = ""
  state submitted: Bool = false

  view {
    Column gap=12 padding=16 {
      Input(value=email, label="Email", placeholder="you@example.com") {
        on input(value) {
          email = value
        }
      }

      Input(value=note, label="Note", placeholder="Short note") {
        on input(value) {
          note = value
        }
      }

      Button("Submit") {
        on click {
          submitted = true
        }
      }

      if submitted {
        Box padding=16 {
          Text("Submitted {email}: {note}")
        }
      } else {
        Text("Waiting for submit.")
      }
    }
  }
}
